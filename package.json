{
  "name": "chatlyzer",
  "version": "0.1.0",
  "description": "A lightweight tool for analyzing chat data from Telegram JSON exports",
  "keywords": [
    "analytics",
    "chat",
    "cli",
    "export",
    "telegram"
  ],
  "license": "MIT",
  "bin": "./dist/index.mjs",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "node src/index.ts",
    "start": "node dist/index.mjs",
    "check": "tsc --noEmit && oxlint && oxfmt --check",
    "fix": "oxlint --fix && oxfmt",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.6"
  }
}
