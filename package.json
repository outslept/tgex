{
  "name": "tgex",
  "version": "0.1.0",
  "description": "Zero-dependency TypeScript utilities and analytics for Telegram Desktop JSON exports (result.json)",
  "keywords": [
    "analytics",
    "chat",
    "export",
    "telegram"
  ],
  "homepage": "https://github.com/outslept/tgex#readme",
  "bugs": {
    "url": "https://github.com/outslept/tgex/issues"
  },
  "license": "MIT",
  "author": "outslept",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/outslept/tgex.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "pnpm run fmt:check && pnpm run lint && pnpm run typecheck",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
