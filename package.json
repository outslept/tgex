{
  "name": "chatlyzer",
  "version": "0.1.0",
  "description": "A lightweight tool for analyzing chat data from Telegram JSON exports",
  "keywords": [
    "analytics",
    "chat",
    "cli",
    "export",
    "telegram"
  ],
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "start": "node dist/index.mjs",
    "check": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20.12"
  }
}
